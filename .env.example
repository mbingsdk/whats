# Copy names into your protected environment; never commit populated copies.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
PUBLIC_ORIGIN=http://localhost:3000
# Prefer an absolute path to a protected PostgreSQL URL file.
DATABASE_URL_FILE=
MIGRATION_DATABASE_URL_FILE=
DB_POOL_MAX=10
LOG_LEVEL=INFO
HTTP_MAX_HEADER_BYTES=16384
HTTP_MAX_BODY_BYTES=1048576
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
# Mandatory in production; all SMTP fields may be omitted in local Sprint 0.
SMTP_HOST=
SMTP_PORT=
SMTP_TLS_MODE=
SMTP_SENDER=
SMTP_USERNAME=
SMTP_PASSWORD_FILE=
SMTP_TIMEOUT=10s
# Server-only frontend configuration, never NEXT_PUBLIC_DATABASE_URL or tokens.
BACKEND_ORIGIN=http://127.0.0.1:8080
# No Graph version default: current official contract remains unverified.
