# Copy names into your protected environment; never commit populated copies.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
PUBLIC_ORIGIN=http://localhost:3000
# Prefer an absolute path to a protected PostgreSQL URL file.
DATABASE_URL_FILE=
MIGRATION_DATABASE_URL_FILE=
DB_POOL_MAX=10
LOG_LEVEL=INFO
HTTP_MAX_HEADER_BYTES=16384
HTTP_MAX_BODY_BYTES=1048576
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
# Mandatory in production; local test SMTP is supplied by the isolated test harness.
SMTP_HOST=
SMTP_PORT=
SMTP_TLS_MODE=
SMTP_SENDER=
SMTP_USERNAME=
SMTP_PASSWORD_FILE=
SMTP_TIMEOUT=10s
# Server-only frontend configuration, never NEXT_PUBLIC_DATABASE_URL or tokens.
BACKEND_ORIGIN=http://127.0.0.1:8080

# Dedicated limited identity connection and separate 32-byte base64 encryption key.
IDENTITY_DATABASE_URL_FILE=
IDENTITY_ROOT_KEY_FILE=
# Operator bootstrap only. Never set a password directly in environment or argv.
BOOTSTRAP_PASSWORD_FILE=
BOOTSTRAP_EMAIL=
BOOTSTRAP_NAME=
BOOTSTRAP_ORGANIZATION_SLUG=
BOOTSTRAP_TIMEZONE=
# Optional explicit existing organization; normally omitted.
BOOTSTRAP_ORGANIZATION_ID=

# Gate B operator configuration: copy this section to .local/meta-gate-b.env.
# These inputs are for explicit read-only verification, not automatic app startup.
# Set the version explicitly. v26.0 is the approved test candidate, not a verified default.
META_GRAPH_VERSION=
# Required Meta App ID (numeric identifier).
META_APP_ID=
# Supply a WABA ID, or a Business Portfolio ID for owned-WABA discovery.
META_BUSINESS_PORTFOLIO_ID=
META_WABA_ID=
# Optional known phone-number ID; otherwise discovered from the WABA.
META_PHONE_NUMBER_ID=
# File paths only: put each secret in its own protected file, never in this example.
# Absolute Windows paths are supported, e.g. E:/private/meta-access-token.txt.
META_ACCESS_TOKEN_FILE=
META_APP_SECRET_FILE=
META_WEBHOOK_VERIFY_TOKEN_FILE=
# App Secret signs POST notifications; Verify Token is for the GET challenge.
# No messages or account mutations are authorized by filling in these variables.
